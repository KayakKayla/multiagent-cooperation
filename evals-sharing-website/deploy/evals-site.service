[Unit]
Description=SE390 public evaluation archive
After=network.target

[Service]
Type=simple
User=evals-site
Group=evals-site
WorkingDirectory=/opt/results-site/evals-sharing-website
EnvironmentFile=/etc/evals-site/site.env
ExecStart=/opt/results-site/evals-sharing-website/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --timeout-keep-alive 5 --no-access-log
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/evals-site

[Install]
WantedBy=multi-user.target
